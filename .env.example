# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://explore.openaq.org/register
OPENAQ_API_KEY=

# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Hugging Face write token (Settings -> Access Tokens) and the dataset to write to
HF_TOKEN=
HF_DATASET_REPO=Anushkajoshii/breathe-check-data

# From @BotFather on Telegram (only needed for the daily alert)
TELEGRAM_BOT_TOKEN=
